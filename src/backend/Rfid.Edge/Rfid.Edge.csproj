<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Reader edge agent: drives LLRP readers / receives vendor webhooks on site, stores batches on disk and
       forwards them to the platform with monotonically increasing batch ids (store-and-forward). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>rfid-edge</UserSecretsId>
    <RootNamespace>Rfid.Edge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rfid.Protocols\Rfid.Protocols.csproj" />
  </ItemGroup>

</Project>
